# =====================================================================
# Reference payload (papers, arXiv source, OCR pages, book scans).
# Kept LOCAL, never committed (copyright + size). Only the SHA256 manifest
# is tracked, so provenance is auditable from a clean checkout; the
# check-refs / check-provenance gates WARN (not fail) when a payload is absent.
# =====================================================================
/refs/*
!/refs/manifest/
/refs/manifest/*
!/refs/manifest/SOURCES.md
!/refs/manifest/checksums.sha256
!/refs/manifest/sources.lock.json

# =====================================================================
# af proof workspaces (proofs/<lemma-id>/): when af is stood up, the ledger
# is the source of truth; track ledger/ + externals/ + meta.json; ignore the
# reconstructable per-command caches and claim locks.
# =====================================================================
proofs/**/nodes/
proofs/**/defs/
proofs/**/lemmas/
proofs/**/assumptions/
proofs/**/locks/
proofs/**/*.lock

# =====================================================================
# Generated LaTeX build products.
# =====================================================================
# check-provenance --build compiles into this scratch dir so the gate never
# mutates the tracked report/main.pdf (latexmk's .fdb cache keeps it fast).
report/.build/
report/*.aux
report/*.bbl
report/*.bcf
report/*.blg
report/*.fdb_latexmk
report/*.fls
report/*.out
report/*.run.xml
report/*.synctex.gz
report/*.toc
report/*.log

# Keep the compiled report + the manuscript's figure asset, but ignore other
# PDFs by default to avoid accidentally publishing copied literature files.
*.pdf
!report/main.pdf
!report/figures/dag.pdf
!paper/figure.pdf

# =====================================================================
# Python and local tooling caches.
# =====================================================================
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/

# =====================================================================
# Claude Code harness: track the shared settings (bd prime hooks); ignore the
# rest of .claude/ (scheduled-task locks, per-session scratch).
# =====================================================================
.claude/*
!.claude/settings.json

# =====================================================================
# fr (frontier) explore/exploit controller state.
# The append-only log + portfolio ARE the campaign record — TRACK them.
# The compiled binary (self-contained variant) and raw verdict logs are local.
# =====================================================================
.frontier/bin/
.frontier/verdicts/*.raw
.frontier/turn.json

# OS/editor noise.
.DS_Store
*.swp
*.swo

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Untracked refs acquisition scratch (copyrighted PDFs; integrated into refs/ via manifest only)
refs-staging/

# playwright-cli snapshot/console scratch
.playwright-cli/

# Standalone proof-report build products (writeups/<id>.pdf is covered by *.pdf above).
writeups/*.aux
writeups/*.log
writeups/*.out
writeups/*.fls
writeups/*.fdb_latexmk
writeups/*.toc
writeups/*.synctex.gz
proofs/**/.af/
